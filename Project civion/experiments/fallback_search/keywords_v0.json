      "value_hints": ["@kg_m3", "@percent"],
      "exclude": ["mg/l", "mg/litre", "ppm"],
      "descriptive": false
    },
    "measured_so3_percent": {
      "terms": ["so3", "so 3", "sulphate content", "sulfate content", "sulphuric anhydride", "total sulphate", "total sulfate", "water soluble sulphate", "sulphates", "sulfates"],
      "value_hints": ["@percent"],
      "exclude": ["mg/l", "g/l", "soil", "ground water", "groundwater"],
      "descriptive": false
    },
    "fire_resistance_rating": {
      "terms": ["fire resistance", "fire rating", "fire rated", "fire resistant", "frr", "fire"],
      "value_hints": ["@hours", "@minutes"],
      "exclude": [],
      "descriptive": false
    },
    "member_covers": {
      "terms": ["cover", "covers", "clear cover", "nominal cover", "concrete cover", "cover to reinforcement", "minimum cover", "cover blocks", "spacers"],
      "value_hints": ["@mm"],
      "exclude": [],
      "descriptive": false
    },
    "water_organic_mg_l": {
      "terms": ["organic", "organic solids", "organic matter", "organic impurities"],
      "value_hints": ["@mg_l"],
      "exclude": [],
      "descriptive": false
    },
    "water_inorganic_mg_l": {
      "terms": ["inorganic", "inorganic solids", "inorganic matter", "total dissolved solids", "tds"],
      "value_hints": ["@mg_l"],
      "exclude": [],
