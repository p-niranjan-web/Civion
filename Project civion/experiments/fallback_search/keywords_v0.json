    "compaction_method": {
      "terms": ["compaction", "compacted", "compacting", "vibrator", "vibrators", "vibrated", "vibration", "needle vibrator", "immersion vibrator", "poker", "surface vibrator", "form vibrator", "rodding", "tamping", "ramming", "consolidation", "consolidated"],
      "value_hints": [],
      "exclude": [],
