{
  "_note": "v0 draft written from parser.py schema + database.py + general IS 456 / IS 383 / IS 516 / ACI / BS wording, BEFORE opening the BLR document. Terms are plain phrases (case-insensitive, word-bounded, hyphens treated as spaces). value_hints are regexes over normalized lowercase text; '@name' refers to hint_macros. exclude entries are plain phrases.",
  "hint_macros": {
    "@kg_m3": "kg\\s*/\\s*(m3|m\\^3|cum|cu\\.?\\s*m|cubic\\s*m)|kg\\s*per\\s*(m3|cum|cu\\.?\\s*m|cubic)",
    "@n_mm2": "n\\s*/\\s*mm\\s*2|\\bmpa\\b|n\\s*per\\s*(sq\\.?\\s*)?mm|kg\\s*/\\s*cm\\s*2",
    "@mm": "\\b\\d+(\\.\\d+)?\\s*mm\\b",
    "@mg_l": "mg\\s*/\\s*(l|lit|litre|liter|ltr)\\b|mg\\s*per\\s*lit|\\bppm\\b|parts\\s*per\\s*million",
    "@minutes": "\\b\\d+(\\.\\d+)?\\s*(minutes?|mins?)\\b",
    "@seconds": "\\b\\d+\\s*(seconds?|secs?)\\b",
    "@hours": "\\b\\d+(\\.\\d+)?\\s*(hours?|hrs?|h)\\b",
    "@days": "\\b\\d+\\s*days?\\b",
    "@volume": "(?<![/\\d])\\b\\d[\\d,]*(\\.\\d+)?\\s*(m3|cum\\b|cu\\.?\\s*m\\b|cubic\\s*met)",
    "@percent": "\\d\\s*(%|per\\s*cent|percent)",
    "@ratio": "(?<![\\d.])0?\\.\\d{1,3}\\b",
    "@grade": "\\bm\\s*-?\\s*\\d{2}\\b",
    "@small_number": "\\b(?:[3-9]|1[0-4])(?:\\.\\d+)?\\b"
  },
  "global_exclude": {
    "_why": "Reference-list lines: a unit that starts with a code number (IS 456, BS 8110, ASTM C94...) and has no requirement wording is only a citation/title.",
    "code_line_regex": "^\\W*(\\d+[.)]\\s*)?(is|bs|bs en|en|astm|aci|irc|sp)\\s*[:\\-]?\\s*\\d",
    "requirement_words": ["shall", "should", "must", "not less than", "not more than", "not exceed", "minimum", "maximum", "min.", "max.", "at least", "limit"]
  },
  "parameters": {
    "water_ph": {
      "terms": ["ph", "ph value", "ph of water", "hydrogen ion concentration", "acidity", "alkalinity"],
      "value_hints": ["@small_number"],
      "exclude": [],
      "descriptive": false
    },
    "specified_grade": {
      "terms": ["grade of concrete", "concrete grade", "grade", "grades", "class of concrete", "concrete class", "mix", "design mix", "characteristic compressive strength"],
      "value_hints": ["@grade"],
      "exclude": ["bolt", "bolts", "threaded"],
      "descriptive": false
    },
    "cement_type": {
      "terms": ["ordinary portland cement", "opc", "portland pozzolana cement", "ppc", "portland slag cement", "psc", "sulphate resisting", "sulfate resisting", "src", "ggbs", "ground granulated blast furnace slag", "fly ash", "pulverised fuel ash", "pfa", "type of cement", "blended cement", "43 grade", "53 grade", "mineral admixture", "silica fume", "microsilica"],
      "value_hints": [],
      "exclude": [],
      "descriptive": true
    },
    "specified_min_cement": {
      "terms": ["minimum cement content", "min cement content", "cement content", "cementitious content", "cementitious material content", "cementitious materials content", "binder content", "minimum cementitious", "quantity of cement", "cement per cubic"],
      "value_hints": ["@kg_m3"],
      "exclude": [],
      "descriptive": false
    },
    "specified_max_cement": {
      "terms": ["maximum cement content", "max cement content", "cement content", "cementitious content", "cementitious material content", "cementitious materials content", "binder content", "maximum cementitious", "quantity of cement"],
      "value_hints": ["@kg_m3"],
      "exclude": [],
      "descriptive": false
    },
    "specified_wc": {
      "terms": ["water cement ratio", "water/cement ratio", "w/c", "w/c ratio", "water cementitious ratio", "water/cementitious", "water binder ratio", "water/binder", "w/b", "free water", "w/cm"],
      "value_hints": ["@ratio"],
      "exclude": [],
      "descriptive": false
    },
    "specified_characteristic_strength": {
      "terms": ["characteristic strength", "characteristic compressive strength", "fck", "f ck", "compressive strength", "cube strength", "28 day strength", "28 days strength", "crushing strength", "specified strength"],
      "value_hints": ["@n_mm2"],
      "exclude": [],
      "descriptive": false
    },
    "specified_sigma": {
      "terms": ["standard deviation", "assumed standard deviation", "established standard deviation", "sigma", "σ", "target mean strength", "target strength", "current margin", "margin"],
      "value_hints": ["@n_mm2", "@small_number"],
      "exclude": [],
      "descriptive": false
    },
    "mixing_time_minutes": {
