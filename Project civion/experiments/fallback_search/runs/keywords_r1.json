{
  "_note": "v0 draft written from parser.py schema + database.py + general IS 456 / IS 383 / IS 516 / ACI / BS wording, BEFORE opening the BLR document; round-1 edits per changes.md. Terms are plain phrases (case-insensitive, word-bounded, hyphens treated as spaces). value_hints are regexes over normalized lowercase text; '@name' refers to hint_macros. exclude entries are plain phrases.",
  "hint_macros": {
    "@kg_m3": "kg\\s*/\\s*(m\\s*3|m\\^3|cum|cu\\.?\\s*m|cubic\\s*m)|kg\\s*per\\s*(m\\s*3|cum|cu\\.?\\s*m|cubic)",
    "@n_mm2": "n\\s*/\\s*mm\\s*2|\\bmpa\\b|n\\s*per\\s*(sq\\.?\\s*)?mm|kg\\s*/\\s*cm\\s*2",
    "@mm": "\\b\\d+(\\.\\d+)?\\s*mm\\b",
    "@mg_l": "mg\\s*/\\s*(l|lit|litre|liter|ltr)\\b|mg\\s*per\\s*lit|\\bppm\\b|parts\\s*per\\s*million",
    "@minutes": "\\b\\d+(\\.\\d+)?\\s*(minutes?|mins?)\\b",
    "@seconds": "\\b\\d+\\s*(seconds?|secs?)\\b",
    "@hours": "\\b\\d+(\\.\\d+)?\\s*(hours?|hrs?|h)\\b",
    "@days": "\\b\\d+\\s*days?\\b",
    "@volume": "(?<![/\\d])\\b\\d[\\d,]*(\\.\\d+)?\\s*(m\\s*3\\b|cum\\b|cu\\.?\\s*m\\b|cubic\\s*met)",
    "@percent": "\\d\\s*(%|per\\s*cent|percent)",
    "@ratio": "(?<![\\d.])0?\\.\\d{1,3}\\b",
    "@grade": "\\bm\\s*-?\\s*\\d{2}\\b",
    "@small_number": "\\b(?:[3-9]|1[0-4])(?:\\.\\d+)?\\b"
  },
